#!/usr/bin/env python3
"""hk — the herdr-kitten CLI. Every verb is a socket/CLI join, never a scheduler.

Stdlib-only (spec D1). Exit codes (spec D9 + census exit conventions):
  0 delivered/ok, 1 herdr error, 2 usage, 3 not-a-herdr-window (voice), 4 not implemented yet.
"""

from __future__ import annotations

import argparse
import os
import sys

_ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if _ROOT not in sys.path:
    sys.path.insert(0, _ROOT)

from hk import VERSION  # noqa: E402
from hk import verbs  # noqa: E402


def _stub(verb: str):
    def _run(_args: argparse.Namespace) -> int:
        print(f"hk {verb}: not implemented yet (lands in stages S3-S5)", file=sys.stderr)
        return verbs.EXIT_NOT_IMPLEMENTED
    return _run


def _cmd_doctor(_args: argparse.Namespace) -> int:
    """spec 1.5: kitty version, herdr version + wire protocol, socket
    reachability, predicate result for the current window. Version floors are
    D19: kitty >= 0.47.1, herdr >= 0.8.2 / protocol 21."""
    import json
    import socket
    import subprocess
    from hk import herdrc, kittyc, predicate

    KITTY_FLOOR = (0, 47, 1)
    HERDR_FLOOR = (0, 8, 2)
    PROTOCOL_FLOOR = 21

    def tool(argv):
        try:
            proc = subprocess.run(argv, capture_output=True, text=True, timeout=10)
            output = (proc.stdout or proc.stderr).strip()
            return output.splitlines()[0] if output else "unknown"
        except (OSError, subprocess.TimeoutExpired) as exc:
            return f"not found ({exc.__class__.__name__})"

    def parsed(text):
        for word in text.split():
            parts = word.split(".")
            if len(parts) >= 2 and all(p.isdigit() for p in parts[:3]):
                return tuple(int(p) for p in parts[:3])
        return None

    def verdict(found, floor):
        """A tool that is ABSENT is reported, not failed: a headless host with
        no kitty is a real deployment, not a broken one. Only a tool that is
        present and below its D19 floor is a doctor failure."""
        if found is None:
            return "absent"
        return "ok" if found >= floor else f"BELOW FLOOR {'.'.join(map(str, floor))}"

    violations = []
    print(f"hk: {VERSION}")
    for name, argv, floor in (("kitty", ["kitty", "--version"], KITTY_FLOOR),
                              ("herdr", ["herdr", "--version"], HERDR_FLOOR)):
        line = tool(argv)
        state = verdict(parsed(line), floor)
        print(f"{name}: {line} [{state}]")
        if state.startswith("BELOW"):
            violations.append(f"{name} {state}")

    override = os.environ.get("HERDR_SOCKET_PATH")
    config_home = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    sock_path = override or os.path.join(config_home, "herdr", "herdr.sock")
    state = "absent"
    if os.path.exists(sock_path):
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        probe.settimeout(2.0)
        try:
            probe.connect(sock_path)
            state = "reachable"
        except OSError as exc:
            state = f"unreachable ({exc})"
        finally:
            probe.close()
    print(f"socket: {sock_path} [{state}]")
    if state != "reachable":
        violations.append(f"herdr socket {state}")

    # wire protocol is the compatibility axis that actually breaks things (D19)
    try:
        status = json.loads(herdrc.run(["status", "--json"], check=False).stdout or "{}")
    except (ValueError, OSError):
        status = {}
    client_proto = (status.get("client") or {}).get("protocol")
    server = status.get("server") or {}
    print(f"protocol: client {client_proto or '?'} / server {server.get('protocol') or '?'}"
          f" [{verdict((client_proto,) if client_proto else None, (PROTOCOL_FLOOR,))}]")
    if server.get("running"):
        print(f"server: running, compatible={server.get('compatible')}")
    else:
        print("server: not running")

    try:
        window = kittyc.current_window() if kittyc.available() else None
    except kittyc.KittyError as exc:
        window = None
        print(f"predicate: kitty unreachable ({exc})")
    if window is not None:
        print(f"predicate (window {window.get('id')}): "
              f"herdr_client={predicate.is_herdr_client(window)} "
              f"role={predicate.role_of(window)}")
    elif kittyc.available():
        pass
    else:
        print("predicate: not inside a kitty window (KITTY_WINDOW_ID/KITTY_LISTEN_ON unset)")
    if violations:
        print("hk doctor: " + "; ".join(violations), file=sys.stderr)
        return verbs.EXIT_HERDR_ERROR
    return verbs.EXIT_OK


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="hk",
                                     description="herdr IS the kitty kitten: the CLI half.")
    parser.add_argument("--version", action="store_true", help="print version and exit")
    parser.add_argument("--host", default=None,
                        help="run herdr calls over ssh HOST (kitty calls stay local)")
    sub = parser.add_subparsers(dest="verb")

    sub.add_parser("doctor", help="versions, socket, predicate").set_defaults(func=_cmd_doctor)

    p = sub.add_parser("open", help="get-or-create pane in this window's workspace, attach")
    p.add_argument("--print", dest="print_only", action="store_true",
                   help="print the pane id instead of attaching")
    p.set_defaults(func=verbs.cmd_open)

    p = sub.add_parser("run", help="run argv in a self-reaping trampoline pane")
    p.add_argument("argv", nargs=argparse.REMAINDER)
    p.set_defaults(func=verbs.cmd_run)

    p = sub.add_parser("send", help="stdin -> pane, populate-only (never submits)")
    p.add_argument("--submit", action="store_true", help="route through agent prompt")
    p.add_argument("--raw", action="store_true",
                   help="literal bytes, no bracketed-paste framing and no "
                        "terminator scrubbing. Byte-transparent, and sharp: a "
                        "payload can end the paste bracket and be typed as "
                        "input, newlines included.")
    p.add_argument("pane")
    p.set_defaults(func=verbs.cmd_send)

    p = sub.add_parser("read", help="read pane scrollback (recent-unwrapped)")
    p.add_argument("pane")
    p.add_argument("--lines", type=int, default=None)
    p.add_argument("--text", action="store_true", help="plain text instead of ansi")
    p.set_defaults(func=verbs.cmd_read)

    p = sub.add_parser("rename", help="rename pane: durable + live + surface tiers")
    p.add_argument("pane")
    p.add_argument("label", nargs="+")
    p.set_defaults(func=verbs.cmd_rename)

    p = sub.add_parser("focus", help="focus the kitty window projecting a pane")
    p.add_argument("pane")
    p.set_defaults(func=verbs.cmd_focus)

    p = sub.add_parser("materialise", help="project a workspace onto kitty OS windows")
    p.add_argument("workspace")
    p.set_defaults(func=verbs.cmd_materialise)

    p = sub.add_parser("dematerialise", help="close projecting windows; panes survive")
    p.add_argument("workspace")
    p.set_defaults(func=verbs.cmd_dematerialise)

    p = sub.add_parser("new", help="new workspace (git-basename label) + window")
    p.add_argument("--label", default=None)
    p.add_argument("--no-window", dest="no_window", action="store_true")
    p.set_defaults(func=verbs.cmd_new)

    p = sub.add_parser("ws", help="workspace verbs: list/new/focus/rename")
    p.add_argument("ws_verb", choices=["list", "new", "focus", "rename"])
    p.add_argument("arg", nargs="?", default=None)
    p.add_argument("rest", nargs=argparse.REMAINDER)
    p.set_defaults(func=verbs.cmd_ws)

    p = sub.add_parser("resume", help="pick a pane; attach by terminal_id")
    p.add_argument("--print", dest="print_only", action="store_true")
    p.add_argument("--attach", default=None, metavar="TERMINAL_ID")
    p.set_defaults(func=verbs.cmd_resume)

    p = sub.add_parser("agent", help="agent verbs (rename: slug-validating)")
    p.add_argument("agent_verb", choices=["rename"])
    p.add_argument("target")
    p.add_argument("name")
    p.set_defaults(func=verbs.cmd_agent)

    sub.add_parser("config", help="print effective hk-config").set_defaults(func=verbs.cmd_config)

    p = sub.add_parser("ssh", help="remote tiers: herdr thin client or plain kitten ssh")
    p.add_argument("--plain", action="store_true", help="pure kitten ssh, herdr-free")
    p.add_argument("--in-place", action="store_true", help="exec in this window instead of launching one")
    p.add_argument("sshhost")
    p.set_defaults(func=_cmd_ssh)

    p = sub.add_parser("voice", help="dictation endpoint: begin|text|end (exit 3 = fall back)")
    voice_sub = p.add_subparsers(dest="voice_verb", required=True)
    vb = voice_sub.add_parser("begin", help="recording spinner on")
    vb.add_argument("--window", required=True)
    vb.add_argument("--spin", action="store_true",
                    help="RESERVED, not implemented: says so on stderr and shows "
                         "the static glyph (frame-cycling is DECISION-2, open)")
    vb.set_defaults(func=_cmd_voice)
    vt = voice_sub.add_parser("text", help="stdin -> focused window's herdr pane")
    vt.add_argument("--submit", action="store_true")
    # Accepted so a daemon's naive `hk voice text <words>` reaches the exit-3
    # fallback contract instead of an argparse usage dump; refused, never
    # delivered, once there IS a destination. The payload is always on stdin.
    vt.add_argument("text", nargs="*",
                    help="refused: the dictated text is read from stdin, never argv")
    vt.set_defaults(func=_cmd_voice)
    ve = voice_sub.add_parser("end", help="recording spinner off")
    ve.add_argument("--window", required=True)
    ve.set_defaults(func=_cmd_voice)

    p = sub.add_parser("notifyd", help="the ONE event loop: notifications + user-var mirrors")
    p.set_defaults(func=_cmd_notifyd)

    stub = sub.add_parser("fork", help="fork is a kitten gesture (kitten hk.py fork); CLI alias TBD")
    stub.add_argument("rest", nargs=argparse.REMAINDER)
    stub.set_defaults(func=_stub("fork"))
    return parser


def _cmd_ssh(args):
    from hk import remote
    return remote.cmd_ssh(args.sshhost, plain=args.plain, in_place=args.in_place)


def _cmd_voice(args):
    from hk import voice
    if args.voice_verb == "begin":
        return voice.cmd_begin(args.window, spin=args.spin)
    if args.voice_verb == "end":
        return voice.cmd_end(args.window)
    return voice.cmd_text(submit=args.submit, argv_text=args.text)


def _cmd_notifyd(_args):
    from hk import notifyd
    return notifyd.main()


def main(argv: list[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    if args.version:
        print(f"hk {VERSION}")
        return verbs.EXIT_OK
    if not getattr(args, "func", None):
        build_parser().print_help()
        return verbs.EXIT_USAGE
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
